SERIAL_PORT=/dev/ttyUSB0
PRE_TX_DELAY=1.0
POST_TX_DELAY=1.0

FCC_ID=WRXC682
ID_MINS=15
RPT_INFO_MINS=60
ID_WHEN_ASLEEP=False
RPT_INFO_WHEN_ASLEEP=False
SLEEP_AFTER_MINS=10
WAKE_AFTER_SEC=2
MIN_REC_SEC=2
PARROT_MODE=False

DAY_START=07:00
DAY_END=22:00
DAY_SLEEP_AFTER_MINS=240
TIME_WX_ENABLED=True
WX_LAT=0.0
WX_LON=0.0
CMD_NET_TOGGLE=556

